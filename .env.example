# Banco de dados (Neon — Postgres serverless)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# IA (opencode Go) — chave pessoal criada em https://opencode.ai/console
OPENCODE_API_KEY="sua-chave-do-console-opencode"

# Opcional: modelo usado pela IA (padrão: mimo-v2.5)
# AI_MODEL="mimo-v2.5"

# Sessão — gere um segredo aleatório: `openssl rand -base64 32`
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# Credenciais de acesso (conta única)
SEED_EMAIL="voce@exemplo.com"
SEED_PASSWORD="troque-por-uma-senha-forte"
